AT_SETUP([short cursor name])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
           01 DATA1 PIC X(10).
           01 S1 PIC X(100) VARYING. 
           EXEC SQL END DECLARE SECTION END-EXEC.

       PROCEDURE DIVISION.
           EXEC SQL
             DECLARE C1 CURSOR FOR 
               SELECT DATA1 FROM TABLE1
           END-EXEC.
           EXEC  SQL
             PREPARE P1 FROM :S1
           END-EXEC.
           EXEC SQL
             DECLARE C1 CURSOR FOR P1 
           END-EXEC.
           EXEC SQL
             OPEN C1
           END-EXEC.
           EXEC SQL
             OPEN C1 USING :DATA1
           END-EXEC.
           EXEC SQL
             FETCH C1 INTO :DATA1
           END-EXEC.
           EXEC SQL
             CLOSE C1
           END-EXEC.
           GOBACK.
])
AT_CHECK([ocesql prog.cbl prog.cob > /dev/null])
AT_CHECK([grep prog_C1 prog.cob], [0],
[OCESQL          BY REFERENCE "prog_C1" & x"00"
OCESQL          BY REFERENCE "prog_C1" & x"00"
OCESQL          BY REFERENCE "prog_C1" & x"00"
OCESQL          BY REFERENCE "prog_C1" & x"00"
OCESQL          BY REFERENCE "prog_C1" & x"00"
OCESQL          BY REFERENCE "prog_C1" & x"00"
])
AT_CHECK([${COMPILE_MODULE} prog.cob], [0])

AT_CLEANUP

