AT_DATA([prog.pre], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
OCESQL*    EXEC SQL INCLUDE SQLCA END-EXEC.
OCESQL     copy "sqlca.cbl".
OCESQL*    EXEC SQL BEGIN DECLARE SECTION END-EXEC.
           01 DATA1 PIC X(10).
OCESQL*    01 S1 PIC X(100) VARYING. 
OCESQL     01 S1.
OCESQL       02 S1-LEN PIC S9(8) COMP-5.
OCESQL       02 S1-ARR PIC X(100).
OCESQL*    EXEC SQL END DECLARE SECTION END-EXEC.

OCESQL*
OCESQL 01  SQ0001.
OCESQL     02  FILLER PIC X(024) VALUE "SELECT DATA1 FROM TABLE1".
OCESQL     02  FILLER PIC X(1) VALUE X"00".
OCESQL*
       PROCEDURE DIVISION.
OCESQL*    EXEC SQL
OCESQL*      DECLARE C1_12345678901234567890123456789012345678901234
OCESQL*       CURSOR FOR 
OCESQL*        SELECT DATA1 FROM TABLE1
OCESQL*    END-EXEC.
OCESQL     CALL "OCESQLCursorDeclare" USING
OCESQL          BY REFERENCE SQLCA
OCESQL          BY REFERENCE 
OCESQL     "prog_C1_12345678901234567890123456789012345678901234"
OCESQL         & x"00"
OCESQL          BY REFERENCE SQ0001
OCESQL     END-CALL.
OCESQL*    EXEC  SQL
OCESQL*      PREPARE P1 FROM :S1
OCESQL*    END-EXEC.
OCESQL     CALL "OCESQLPrepare" USING
OCESQL          BY REFERENCE SQLCA
OCESQL          BY REFERENCE "P1" & x"00"
OCESQL          BY REFERENCE S1-ARR
OCESQL          BY VALUE S1-LEN
OCESQL     END-CALL.
OCESQL*    EXEC SQL
OCESQL*      DECLARE C1_12345678901234567890123456789012345678901234
OCESQL*       CURSOR FOR P1 
OCESQL*    END-EXEC.
OCESQL     CALL "OCESQLPreparedCursorDeclare" USING
OCESQL          BY REFERENCE SQLCA
OCESQL          BY REFERENCE 
OCESQL     "prog_C1_12345678901234567890123456789012345678901234"
OCESQL         & x"00"
OCESQL          BY REFERENCE "P1" & x"00"
OCESQL     END-CALL.
OCESQL*    EXEC SQL
OCESQL*      OPEN C1_12345678901234567890123456789012345678901234
OCESQL*    END-EXEC.
OCESQL     CALL "OCESQLCursorOpen" USING
OCESQL          BY REFERENCE SQLCA
OCESQL          BY REFERENCE 
OCESQL     "prog_C1_12345678901234567890123456789012345678901234"
OCESQL         & x"00"
OCESQL     END-CALL.
OCESQL*    EXEC SQL
OCESQL*      OPEN C1_12345678901234567890123456789012345678901234
OCESQL*       USING :DATA1
OCESQL*    END-EXEC.
OCESQL     CALL "OCESQLStartSQL"
OCESQL     END-CALL
OCESQL     CALL "OCESQLSetSQLParams" USING
OCESQL          BY VALUE 16
OCESQL          BY VALUE 10
OCESQL          BY VALUE 0
OCESQL          BY REFERENCE DATA1
OCESQL     END-CALL
OCESQL     CALL "OCESQLCursorOpenParams" USING
OCESQL          BY REFERENCE SQLCA
OCESQL          BY REFERENCE 
OCESQL     "prog_C1_12345678901234567890123456789012345678901234"
OCESQL         & x"00"
OCESQL          BY VALUE 1
OCESQL     END-CALL
OCESQL     CALL "OCESQLEndSQL"
OCESQL     END-CALL.
OCESQL*    EXEC SQL
OCESQL*      FETCH C1_12345678901234567890123456789012345678901234
OCESQL*       INTO :DATA1
OCESQL*    END-EXEC.
OCESQL     CALL "OCESQLStartSQL"
OCESQL     END-CALL
OCESQL     CALL "OCESQLSetResultParams" USING
OCESQL          BY VALUE 16
OCESQL          BY VALUE 10
OCESQL          BY VALUE 0
OCESQL          BY REFERENCE DATA1
OCESQL     END-CALL
OCESQL     CALL "OCESQLCursorFetchOne" USING
OCESQL          BY REFERENCE SQLCA
OCESQL          BY REFERENCE 
OCESQL     "prog_C1_12345678901234567890123456789012345678901234"
OCESQL         & x"00"
OCESQL     END-CALL
OCESQL     CALL "OCESQLEndSQL"
OCESQL     END-CALL.
OCESQL*    EXEC SQL
OCESQL*      CLOSE C1_12345678901234567890123456789012345678901234
OCESQL*    END-EXEC.
OCESQL     CALL "OCESQLCursorClose"  USING
OCESQL          BY REFERENCE SQLCA
OCESQL          BY REFERENCE 
OCESQL     "prog_C1_12345678901234567890123456789012345678901234"
OCESQL         & x"00"
OCESQL     END-CALL.
           GOBACK.
])
